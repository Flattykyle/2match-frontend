# ===========================================
# 2-Match Frontend Environment Variables
# ===========================================

# API URL (Backend)
VITE_API_URL=http://localhost:3000/api

# Mapbox (for location features)
VITE_MAPBOX_TOKEN=your_mapbox_access_token

# Sentry (Frontend error tracking - Optional)
VITE_SENTRY_DSN=your_frontend_sentry_dsn

# Environment
VITE_ENVIRONMENT=development

# Socket.IO URL (usually same as API URL without /api)
VITE_SOCKET_URL=http://localhost:3000

# ===========================================
# Production Environment Variables
# ===========================================

# For production, update these values:
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_SOCKET_URL=https://api.yourdomain.com
# VITE_MAPBOX_TOKEN=your_production_mapbox_token
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# VITE_ENVIRONMENT=production
