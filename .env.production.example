# ===========================================
# 2-Match Frontend - Production Environment
# ===========================================
# Use this as a template for your production environment variables
# Copy this file and rename it based on your deployment platform:
# - Vercel: Configure in Project Settings > Environment Variables
# - Netlify: Configure in Site Settings > Environment Variables
# - Railway: Configure in Project > Variables

# Backend API URL (REQUIRED)
# Replace with your deployed backend URL from Railway/Render
VITE_API_URL=https://your-backend-url.railway.app/api

# Socket.IO URL (REQUIRED)
# Same as backend URL but without /api
VITE_SOCKET_URL=https://your-backend-url.railway.app

# Mapbox Access Token (REQUIRED for location features)
# Get your token from: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_production_mapbox_access_token

# Environment (REQUIRED)
VITE_ENVIRONMENT=production

# Sentry DSN (OPTIONAL - for frontend error tracking)
# Get from: https://sentry.io/settings/projects/
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ===========================================
# Deployment Platform Specific Notes:
# ===========================================

# VERCEL:
# - Add these in: Project Settings > Environment Variables
# - Select "Production" environment
# - Redeploy after adding variables

# NETLIFY:
# - Add these in: Site Settings > Build & Deploy > Environment
# - No redeploy needed, takes effect immediately

# RAILWAY:
# - Add in: Project > Variables tab
# - Deploy automatically triggers

# ===========================================
# Security Checklist:
# ===========================================
# ✅ Never commit actual .env.production file
# ✅ Use HTTPS URLs only (http:// is insecure)
# ✅ Verify CORS is configured on backend
# ✅ Test all API endpoints after deployment
# ✅ Enable error tracking (Sentry) for production
